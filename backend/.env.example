# Store a real Groq key here in your private local .env file, never in the frontend or Git.
GROQ_API_KEY=your_groq_api_key
# Store your OpenRouter key here so it can handle LLM requests when Groq fails.
OPENROUTER_API_KEY=your_openrouter_api_key
# Use a currently available chat model in the Groq console; this value is configurable.
GROQ_MODEL=openai/gpt-oss-20b
# Whisper Large v3 is the accuracy-focused default for voice transcription.
GROQ_STT_MODEL=whisper-large-v3
# Leave blank for automatic language detection; set en only if the app should force English.
GROQ_STT_LANGUAGE=
# OpenRouter's router can select an eligible free model; replace with a valid slug when required.
OPENROUTER_MODEL=openrouter/free
# Replace with the public URL of the deployed frontend for OpenRouter request attribution.
APP_URL=http://localhost:3000
# These are the allowed browser origins if calling FastAPI directly instead of through the Next.js proxy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reject overly large recordings before they reach the external STT provider.
MAX_AUDIO_MB=12
# Limit requests from a single client address during each minute window.
RATE_LIMIT_PER_MINUTE=20
